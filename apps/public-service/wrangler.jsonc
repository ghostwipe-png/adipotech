{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "public-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "ADMIN_SERVICE",
      "service": "admin-service"
    }
  ]
}