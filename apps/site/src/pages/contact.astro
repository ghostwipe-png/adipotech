---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact Us | Adipotech';
const description = 'Get in touch with Adipotech for support, inquiries, or partnership opportunities.';
---

<BaseLayout title={title} description={description}>
  <main class="page-container">
    <header class="hero">
      <h1>Get in Touch</h1>
      <p class="lead">Whether you need support, want to advertise, or have a general inquiry, our team is ready to assist you.</p>
    </header>

    <div class="contact-grid">
      <!-- Contact Information -->
      <section class="contact-info">
        <h2>Direct Contact</h2>
        <p>For the fastest response, reach out to us directly via any of the channels below:</p>
        
        <div class="info-card">
          <h3>WhatsApp</h3>
          <p>Instant support and quick inquiries.</p>
          <a href="https://wa.me/254112696334" target="_blank" rel="noopener noreferrer" class="contact-link">
            +254 112 696 334
          </a>
        </div>

        <div class="info-card">
          <h3>Email</h3>
          <p>For detailed inquiries and official correspondence.</p>
          <a href="mailto:adipotech@gmail.com" class="contact-link">
            adipotech@gmail.com
          </a>
        </div>

        <div class="info-card">
          <h3>Phone Call</h3>
          <p>Monday to Friday, 9:00 AM to 5:00 PM (EAT).</p>
          <a href="tel:+254112696334" class="contact-link">
            +254 112 696 334
          </a>
        </div>
      </section>

      <!-- Contact Form -->
      <section class="contact-form-section">
        <h2>Send a Message</h2>
        <p>Prefer to send an email directly from here? Fill out the form below and we will get back to you within 24 hours.</p>
        
        <!-- Note: The action attribute will be updated when the backend API is connected -->
        <form class="contact-form" action="#" method="POST">
          <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" required placeholder="John Doe" />
          </div>

          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required placeholder="john@example.com" />
          </div>

          <div class="form-group">
            <label for="subject">Subject</label>
            <select id="subject" name="subject" required>
              <option value="" disabled selected>Select a topic</option>
              <option value="support">Technical Support</option>
              <option value="billing">Billing & Subscriptions</option>
              <option value="advertising">Advertising Inquiry</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required placeholder="How can we help you?"></textarea>
          </div>

          <button type="submit" class="submit-button">Send Message</button>
        </form>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .page-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 1.25rem;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color: #334155;
  }

  .hero {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    color: #0f172a;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .hero .lead {
    font-size: 1.25rem;
    color: #64748b;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  h2 {
    font-size: 1.75rem;
    color: #0f172a;
    margin-bottom: 1rem;
  }

  .contact-info > p,
  .contact-form-section > p {
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .info-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1rem;
  }

  .info-card h3 {
    margin: 0 0 0.5rem 0;
    color: #0f172a;
    font-size: 1.25rem;
  }

  .info-card p {
    margin: 0 0 1rem 0;
    font-size: 0.95rem;
    color: #64748b;
  }

  .contact-link {
    display: inline-block;
    color: #0f172a;
    font-weight: 600;
    text-decoration: none;
    background: #e2e8f0;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    transition: background-color 0.2s ease;
  }

  .contact-link:hover {
    background: #38bdf8;
    color: #ffffff;
  }

  .contact-link:focus-visible {
    outline: 3px solid #38bdf8;
    outline-offset: 2px;
  }

  /* Form Styles */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 600;
    font-size: 0.95rem;
    color: #0f172a;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-family: inherit;
    font-size: 1rem;
    color: #0f172a;
    background: #ffffff;
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #38bdf8;
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
  }

  .submit-button {
    background: #0f172a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0.85rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
    margin-top: 0.5rem;
  }

  .submit-button:hover {
    background: #1e293b;
  }

  .submit-button:focus-visible {
    outline: 3px solid #38bdf8;
    outline-offset: 2px;
  }
</style>