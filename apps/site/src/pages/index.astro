---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Adipotech';
const description =
  'Adipotech media platform for advertisements, pictures, videos, PDFs and secure downloads.';
---

<BaseLayout title={title} description={description}>
  <main class="shell">
    <header class="brand">
      <img src="/logo.svg" alt="Adipotech logo" width="72" height="72" class="brand-mark" />
      <h1 class="brand-name">Adipotech</h1>
    </header>

    <p class="tagline">
      Advertisements, media, PDFs and secure downloads — installable, fast, and built to scale.
    </p>

    <p class="status" id="install-status" aria-live="polite"></p>

    <button id="install-button" class="install-button" type="button" hidden>
      Install Adipotech
    </button>
  </main>

  <script is:inline>
    (function () {
      var deferredPrompt = null;
      var installButton = document.getElementById('install-button');
      var statusEl = document.getElementById('install-status');

      window.addEventListener('beforeinstallprompt', function (event) {
        event.preventDefault();
        deferredPrompt = event;
        if (installButton) installButton.hidden = false;
        if (statusEl) statusEl.textContent = '';
      });

      if (installButton) {
        installButton.addEventListener('click', function () {
          if (!deferredPrompt) return;
          deferredPrompt.prompt();
          deferredPrompt.userChoice.then(function (choice) {
            if (statusEl) {
              statusEl.textContent =
                choice.outcome === 'accepted' ? 'Installing Adipotech…' : 'Installation dismissed.';
            }
            deferredPrompt = null;
            installButton.hidden = true;
          });
        });
      }

      window.addEventListener('appinstalled', function () {
        if (statusEl) statusEl.textContent = 'Adipotech installed.';
        if (installButton) installButton.hidden = true;
      });
    })();
  </script>

  <style>
    .shell {
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
      padding: 2rem 1.25rem;
      text-align: center;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      color: #0f172a;
      background: #ffffff;
    }

    .brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .brand-mark {
      width: 72px;
      height: 72px;
      border-radius: 16px;
    }

    .brand-name {
      margin: 0;
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .tagline {
      margin: 0;
      max-width: 34ch;
      font-size: 1rem;
      line-height: 1.6;
      color: #475569;
    }

    .status {
      margin: 0;
      min-height: 1.25rem;
      font-size: 0.875rem;
      color: #475569;
    }

    .install-button {
      appearance: none;
      border: none;
      border-radius: 999px;
      padding: 0.85rem 1.75rem;
      font-size: 1rem;
      font-weight: 600;
      color: #ffffff;
      background: #0f172a;
      cursor: pointer;
    }

    .install-button:hover {
      background: #1e293b;
    }

    .install-button:focus-visible {
      outline: 3px solid #38bdf8;
      outline-offset: 2px;
    }
  </style>
</BaseLayout>