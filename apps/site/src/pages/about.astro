---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About Us | Adipotech';
const description = 'Learn about Adipotech, a secure, high-performance media and advertisement platform built for creators and audiences.';
---

<BaseLayout title={title} description={description}>
  <main class="page-container">
    <header class="hero">
      <h1>About Adipotech</h1>
      <p class="lead">Empowering brands and creators with a secure, scalable, and lightning-fast media platform.</p>
    </header>

    <section class="content-section">
      <h2>Our Mission</h2>
      <p>
        Adipotech was built to solve a simple problem: sharing rich media (videos, high-resolution images, and PDFs) on the modern web should be fast, secure, and frictionless. We provide a premium space for businesses and individuals to publish advertisements, share exclusive content, and engage with their audience without the bloat of traditional social networks.
      </p>
      <p>
        Whether you are running a small enterprise in Nairobi or reaching a global audience, Adipotech gives you the tools to distribute your message with enterprise-grade reliability.
      </p>
    </section>

    <section class="content-section">
      <h2>What We Offer</h2>
      <div class="features-grid">
        <div class="feature-card">
          <h3>High-Performance Delivery</h3>
          <p>Powered by a global edge network and a Progressive Web App (PWA) architecture, our platform loads instantly on any Android device, even on constrained networks.</p>
        </div>
        <div class="feature-card">
          <h3>Secure Premium Content</h3>
          <p>We offer seamless, recurring premium subscriptions via Paystack. Our strict server-side entitlement engine ensures your premium content is protected and only accessible to authorized subscribers.</p>
        </div>
        <div class="feature-card">
          <h3>Community Engagement</h3>
          <p>Build your audience with integrated comments, likes, and automated notifications. Our systems are designed to handle high traffic without compromising speed.</p>
        </div>
        <div class="feature-card">
          <h3>Flexible Monetization</h3>
          <p>Beyond subscriptions, creators can enable per-post donations and enforce specific engagement actions (like commenting or sharing) before unlocking premium downloads.</p>
        </div>
      </div>
    </section>

    <section class="content-section">
      <h2>Our Commitment to Security</h2>
      <p>
        Security is not an afterthought at Adipotech; it is the foundation. We employ a decoupled architecture that isolates your personal data, payment information, and content. 
      </p>
      <ul class="security-list">
        <li><strong>Zero-Trust Admin Architecture:</strong> Content administration is heavily guarded and completely isolated from the public-facing internet.</li>
        <li><strong>PCI-DSS Compliant Payments:</strong> We never see or store your credit card data. All transactions are processed securely through Paystack's hosted checkout.</li>
        <li><strong>Data Protection:</strong> We strictly adhere to the Kenya Data Protection Act to ensure your privacy is respected and your data is handled responsibly.</li>
      </ul>
    </section>

    <section class="content-section">
      <h2>Contact Us</h2>
      <p>
        Have a question, need support, or want to explore partnership opportunities? We would love to hear from you. Visit our <a href="/contact">Contact Page</a> to get in touch with our team.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .page-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.25rem;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color: #334155;
  }

  .hero {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    color: #0f172a;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .hero .lead {
    font-size: 1.25rem;
    color: #64748b;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .content-section {
    margin-bottom: 3rem;
  }

  .content-section h2 {
    font-size: 1.75rem;
    color: #0f172a;
    margin-bottom: 1.25rem;
    border-bottom: 2px solid #f1f5f9;
    padding-bottom: 0.5rem;
  }

  .content-section p {
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feature-card {
    background: #f8fafc;
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
  }

  .feature-card h3 {
    color: #0f172a;
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .feature-card p {
    margin: 0;
    font-size: 0.95rem;
    color: #475569;
  }

  .security-list {
    list-style-type: none;
    padding: 0;
    margin-top: 1.5rem;
  }

  .security-list li {
    background: #f0f9ff;
    border-left: 4px solid #38bdf8;
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
    border-radius: 0 8px 8px 0;
    line-height: 1.6;
  }

  .security-list strong {
    color: #0f172a;
  }

  a {
    color: #0f172a;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a:hover {
    color: #38bdf8;
  }

  a:focus-visible {
    outline: 3px solid #38bdf8;
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>